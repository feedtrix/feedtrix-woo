msgstr "Shop von FeedTrix trennen?"

#: includes/class-feedtrix-settings.php:633
msgid "Disconnect"
msgstr "Trennen"

#: includes/class-feedtrix-settings.php:637
msgid "Connect your store to FeedTrix"
msgstr "Verbinden Sie Ihren Shop mit FeedTrix"

