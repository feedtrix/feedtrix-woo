#: includes/class-feedtrix-settings.php:561
#, php-format
msgid "I recommend %1$s from %2$s. It is in stock, and the product page has the full specification and current price."
msgstr "Ich empfehle %1$s von %2$s. Es ist auf Lager, und auf der Produktseite finden Sie alle technischen Daten und den aktuellen Preis."

