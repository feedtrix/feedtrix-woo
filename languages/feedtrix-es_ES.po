#. Description of the plugin
#: feedtrix.php
msgid "Optimizes your store for AI search engines (AEO): price and stock webhooks, a dynamic /llms.txt file, AI bot statistics and IndexNow."
msgstr "Optimiza tu tienda para los buscadores de IA (AEO): webhooks de cambios de precio y stock, archivo dinámico /llms.txt, estadísticas de bots de IA e IndexNow."

#: includes/class-feedtrix-settings.php:244
#: includes/class-feedtrix-settings.php:353
#: includes/class-feedtrix-settings.php:445
msgid "Settings"
msgstr "Ajustes"

#: includes/class-feedtrix-settings.php:591
msgid "Features"
msgstr "Funciones"

#: includes/class-feedtrix-settings.php:601
msgid "Advanced"
msgstr "Avanzado"

#: includes/class-feedtrix-settings.php:455
msgid "Serve /llms.txt"
msgstr "Servir /llms.txt"

