msgstr "robots.txt blocca dei bot IA"

#. translators: %s: list of bot names
#: includes/class-feedtrix-site-health.php:110
#, php-format
msgid "These bots cannot read your store, so ChatGPT, Perplexity, Claude or Gemini will not recommend your products: %s. Remove their \"Disallow: /\" rules from robots.txt (often added by a security or SEO plugin)."
msgstr "Questi bot non possono leggere il tuo negozio, quindi ChatGPT, Perplexity, Claude o Gemini non consiglieranno i tuoi prodotti: %s. Rimuovi le loro regole \"Disallow: /\" dal robots.txt (spesso aggiunte da un plugin di sicurezza o SEO)."

#: includes/class-feedtrix-site-health.php:117
msgid "ChatGPT, Perplexity, Claude and Gemini bots can read your store."
msgstr "I bot di ChatGPT, Perplexity, Claude e Gemini possono leggere il tuo negozio."

#: includes/class-feedtrix-site-health.php:124
msgid "FeedTrix serves /llms.txt and /llms-full.txt with your full catalog, AI descriptions, current prices and stock."
msgstr "FeedTrix serve /llms.txt e /llms-full.txt con tutto il catalogo, descrizioni IA, prezzi e disponibilità aggiornati."

#: includes/class-feedtrix-site-health.php:125
msgid "The store serves a basic /llms.txt built from your catalog. With a FeedTrix account it also gets /llms-full.txt with AI descriptions of all products."
msgstr "Il negozio serve un /llms.txt di base costruito dal catalogo. Con un account FeedTrix ottiene anche /llms-full.txt con descrizioni IA di tutti i prodotti."

#: includes/class-feedtrix-site-health.php:127
msgid "Open /llms.txt"
msgstr "Apri /llms.txt"

#: includes/class-feedtrix-site-health.php:133
msgid "The store has no llms.txt file"
msgstr "Il negozio non ha un file llms.txt"

#: includes/class-feedtrix-site-health.php:134
msgid "llms.txt describes your store and products for AI assistants in one tidy file. Turn on \"Serve /llms.txt\" in WooCommerce → FeedTrix → Settings."
msgstr "llms.txt descrive negozio e prodotti per gli assistenti IA in un unico file ordinato. Attiva «Servi /llms.txt» in WooCommerce → FeedTrix → Impostazioni."

#: includes/class-feedtrix-site-health.php:135
#: includes/class-feedtrix-site-health.php:150
msgid "FeedTrix settings"
msgstr "Impostazioni FeedTrix"

#: includes/class-feedtrix-site-health.php:142
msgid "WebMCP tools for AI agents are on"
msgstr "Gli strumenti WebMCP per agenti IA sono attivi"

#: includes/class-feedtrix-site-health.php:142
msgid "AI agents in the browser can search products, check shipping and fill the cart through store tools. The customer always confirms payment."
msgstr "Gli agenti IA nel browser possono cercare prodotti, controllare la spedizione e riempire il carrello con gli strumenti del negozio. Il cliente conferma sempre il pagamento."

#: includes/class-feedtrix-site-health.php:148
msgid "WebMCP tools for AI agents are off"
msgstr "Gli strumenti WebMCP per agenti IA sono disattivati"

#: includes/class-feedtrix-site-health.php:149
msgid "AI agents in the browser (such as Gemini in Chrome) shop faster and without mistakes in stores with WebMCP tools. Turn them on in WooCommerce → FeedTrix → Settings."
msgstr "Gli agenti IA nel browser (come Gemini in Chrome) comprano più in fretta e senza errori nei negozi con strumenti WebMCP. Attivali in WooCommerce → FeedTrix → Impostazioni."
