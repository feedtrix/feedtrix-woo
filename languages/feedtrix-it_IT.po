msgid "Connect store"
msgstr "Collega il negozio"

#: includes/class-feedtrix-onboarding.php:41
msgid "Enter the Store Key (ftx_…) and the API key from the FeedTrix panel."
msgstr "Inserisci lo Store Key (ftx_…) e la chiave API dal pannello FeedTrix."

#: includes/class-feedtrix-onboarding.php:60
msgid "Your store has been disconnected from your FeedTrix account."
msgstr "Il negozio è stato scollegato dal tuo account FeedTrix."

#: includes/class-feedtrix-onboarding.php:79
msgid "Unexpected response from FeedTrix."
msgstr "Risposta inattesa da FeedTrix."

#: includes/class-feedtrix-onboarding.php:100
msgid "Your store is now connected to your FeedTrix account. We emailed you a link to the panel."
msgstr "Il negozio è ora collegato al tuo account FeedTrix. Ti abbiamo inviato via email un link al pannello."

#: includes/class-feedtrix-onboarding.php:105
msgid "You do not have permission to do this."
msgstr "Non hai i permessi per farlo."

#: includes/class-feedtrix-onboarding.php:138
msgid "connect your store so that ChatGPT, Perplexity and Claude can learn about your products."
msgstr "collega il negozio affinché ChatGPT, Perplexity e Claude conoscano la tua offerta."

