#: includes/class-feedtrix-site-health.php:100
#: includes/class-feedtrix-site-health.php:117
msgid "AI bots are not blocked by robots.txt"
msgstr "robots.txt nie blokuje botów AI"

#: includes/class-feedtrix-site-health.php:100
